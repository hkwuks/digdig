{
  "name": "digdig",
  "version": "0.0.2",
  "description": "Web Search Tool - SearXNG, Ollama, and DeepSeek backends",
  "homepage": "https://github.com/hkwuks/digdig#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hkwuks/digdig.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/hkwuks/digdig/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "dg": "dist/index.js",
    "digdig": "dist/index.js",
    "sxng": "dist/sxng.js"
  },
  "files": [
    "dist/",
    "digdig.config.example.json",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc && node -e \"try{for (const f of ['dist/index.js','dist/sxng.js']) require('fs').chmodSync(f,0o755)}catch(e){}\"",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "searxng",
    "search",
    "cli",
    "web-search"
  ],
  "author": "hkwuks",
  "license": "MIT",
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "@orama/plugin-data-persistence": "^3.1.18",
    "@orama/tokenizers": "^3.1.18",
    "axios": "^1.6.0",
    "chunk-smart": "^0.1.2",
    "commander": "^15.0.0",
    "defuddle": "^0.18.0",
    "fastest-levenshtein": "^1.0.16",
    "graphology": "^0.26.0",
    "https-proxy-agent": "^7.0.0",
    "linkedom": "^0.18.12"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "typescript": "^5.3.0",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
